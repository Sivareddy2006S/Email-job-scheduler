# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_EMAILS_INDEX=emails

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Ethereal Email (create a test account at https://ethereal.email)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your-ethereal-user
ETHEREAL_PASSWORD=your-ethereal-password

# Scheduling / Rate limiting
WORKER_CONCURRENCY=5
EMAIL_MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# Bull Board
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
